#include <windows.h>

1 VERSIONINFO
 FILEVERSION @SAIDA_PRODUCT_VERSION_TUPLE@,0
 PRODUCTVERSION @SAIDA_PRODUCT_VERSION_TUPLE@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Saida\0"
            VALUE "FileDescription", "SaidaEngine\0"
            VALUE "FileVersion", "@SAIDA_PRODUCT_VERSION_STRING@\0"
            VALUE "LegalCopyright", "Copyright SaidaEngine Contributors\0"
            VALUE "OriginalFilename", "SaidaEngine.exe\0"
            VALUE "ProductName", "SaidaEngine\0"
            VALUE "ProductVersion", "@SAIDA_PRODUCT_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
