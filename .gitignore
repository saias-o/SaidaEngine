# Build output (CMake/Ninja: objects, exe, compiled SPIR-V shaders, etc.)
/build/
# An optimized native build beside the Debug one (RelWithDebInfo).
/build-rel/

# Blender source files: large, only needed for editing the model, not the build.
*.blend
*.blend1

# Editor / IDE
.vscode/
.idea/
*.user

# Local runtime files
*.local.json
pipeline_cache.bin

# Runtime saves written by the storage API during playtests
WitnessGame/saves/
VerticalSlice/saves/

# Build logs and scratch files
build_*.txt
*.log
*.ii

# Downloaded SDKs and large archives (never source)
*.7z
*.zip

# Editor play-mode backup (regenerated each Play; never source)
.play_mode_backup.scene
*.play_mode_backup.scene

# Optional Python authoring plugin (never part of an exported game).
**/.saida/python-tools/
**/__pycache__/
*.py[cod]
plugins/python-tools/.venv/
plugins/python-tools/build/
plugins/python-tools/dist/
plugins/python-tools/src/*.egg-info/
# The traffic add-on's test binary is built beside its source, because the
# add-on is header-only and absent from CMake.
plugins/traffic/tests/test_traffic
plugins/traffic/tests/test_traffic.exe
# Packaged game build output (artifacts, never source)
MyGame/build/
# saida_tool export-game resolves --out against the PROJECT, so a web export
# lands under <project>/build/ rather than the repo's own build tree.
GTAClone/build/
**/build/export/
build-web/
build-web-player/
build-authoring-wasm/

# Local cross-runtime verification build (same source, pinned player SDK).
/build-web-streaming/
