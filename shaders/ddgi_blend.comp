#version 450
#extension GL_GOOGLE_include_directive : require
#define SAIDA_LIGHTING_COMPUTE
#include "lighting.glsl"
#include "gi_schedule.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=1,rgba16f) uniform writeonly image2D writeIrr;
layout(set=1,binding=2,rgba16f) uniform writeonly image2D writeVis;
PUSH_QUALIFIER Push { int mode;int raysPerProbe;int probeCount;float hysteresis;float distExponent; } pc;
void main() {
    int batch=int(gl_GlobalInvocationID.z);if(batch>=pc.probeCount) return;
    int texels=pc.mode==0?lights.giAtlas.x:lights.giAtlas.y;int T=texels+2;
    ivec2 local=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(local,ivec2(T)))) return;
    ivec2 src=local;
    bool bx=local.x==0 || local.x==T-1,by=local.y==0 || local.y==T-1;
    if(bx && by) src=ivec2(local.x>0?1:texels,local.y>0?1:texels);
    else if(by) src=ivec2(T-1-local.x,local.y+(local.y>0?-1:1));
    else if(bx) src=ivec2(local.x+(local.x>0?-1:1),T-1-local.y);
    int probe=schedule[batch].x;
    ivec2 tile=ivec2(probe%lights.giCounts.w,probe/lights.giCounts.w)*T;
    vec3 direction=octDecode((vec2(src-1)+.5)/float(texels)*2.0-1.0);
    vec3 sum=vec3(0);float weight=0,backs=0;
    for(int r=0;r<pc.raysPerProbe;++r) {
        Ray ray=rays[batch*pc.raysPerProbe+r];backs+=ray.radiance.w;
        float w=max(0.0,dot(direction,ray.dirDist.xyz));
        if(pc.mode==1) w=pow(w,pc.distExponent);
        sum+=(pc.mode==0?ray.radiance.rgb:vec3(ray.dirDist.w,ray.dirDist.w*ray.dirDist.w,0))*w;weight+=w;
    }
    vec3 value=sum/max(weight,1e-6);
    vec4 previous=pc.mode==0?texelFetch(TEX2D(previousIrradiance),tile+src,0):texelFetch(TEX2D(previousVisibility),tile+src,0);
    float h=previous.a>0.0 && schedule[batch].z==0?pc.hysteresis:0.0;
    // Adaptive hysteresis (Majercik 2021): light that really changed (a building
    // streamed in, a wall gone) is taken within an update or two instead of
    // creeping in over seconds; the rays' own noise stays under the thresholds.
    if(pc.mode==0 && h>0.0) {
        vec3 delta=abs(value-previous.rgb);
        float change=max(delta.r,max(delta.g,delta.b))/max(max(previous.r,max(previous.g,previous.b)),.02);
        h*=change>.8?.1:change>.4?.5:1.0;
    }
    // A probe whose rays mostly meet back faces sits inside geometry: it keeps
    // its value but weighs nothing, so surfaces read the probes outside it.
    float valid=pc.mode==0 && backs>.25*float(pc.raysPerProbe)?0.0:1.0;
    vec4 result=vec4(mix(value,previous.rgb,h),valid);
    if(pc.mode==0) imageStore(writeIrr,tile+local,result);else imageStore(writeVis,tile+local,result);
}
