# Keep vendor sources pristine. Compile the same reviewed compatibility patch
# into native and Web builds, and fail at configure time if upstream drifts.
function(saida_enable_rmlui_web_compatibility rmlui_root)
    find_package(Git REQUIRED)
    get_filename_component(rmlui_root "${rmlui_root}" ABSOLUTE)
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/rmlui-web-compatibility.patch")
    set(staging "${CMAKE_CURRENT_BINARY_DIR}/rmlui-web-compatibility/staging")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/rmlui-web-compatibility")
    file(MAKE_DIRECTORY "${staging}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    set(files ElementStyle.cpp StyleSheetSpecification.cpp StyleSheetNode.cpp XMLNodeHandlerBody.cpp)
    foreach(name IN LISTS files)
        configure_file("${rmlui_root}/Source/Core/${name}" "${staging}/${name}" COPYONLY)
    endforeach()
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${output}"
                "${GIT_EXECUTABLE}" apply "${patch}"
        WORKING_DIRECTORY "${staging}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "RmlUi Web compatibility patch no longer applies: ${error}")
    endif()
    get_target_property(sources rmlui_core SOURCES)
    foreach(name IN LISTS files)
        file(SHA256 "${rmlui_root}/Source/Core/${name}" original_hash)
        file(SHA256 "${staging}/${name}" patched_hash)
        if(original_hash STREQUAL patched_hash)
            message(FATAL_ERROR "RmlUi compatibility patch did not modify ${name}")
        endif()
        list(FIND sources "${name}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "RmlUi no longer compiles ${name}; review its Web compatibility patch")
        endif()
        configure_file("${staging}/${name}" "${output}/${name}" COPYONLY)
        list(REMOVE_AT sources ${index})
        list(APPEND sources "${output}/${name}")
    endforeach()
    set_property(TARGET rmlui_core PROPERTY SOURCES "${sources}")
    target_include_directories(rmlui_core PRIVATE "${rmlui_root}/Source/Core")
endfunction()
