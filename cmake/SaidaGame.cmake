include_guard(GLOBAL)

function(saida_add_game target)
    cmake_parse_arguments(GAME "CUSTOM_MAIN;WITH_EDITOR" "PROJECT_DIR;OUTPUT_DIRECTORY" "SOURCES" ${ARGN})
    if(GAME_UNPARSED_ARGUMENTS OR NOT GAME_PROJECT_DIR)
        message(FATAL_ERROR "saida_add_game(${target}) needs PROJECT_DIR and optional SOURCES/CUSTOM_MAIN")
    endif()
    get_filename_component(_root "${GAME_PROJECT_DIR}" ABSOLUTE)
    if(GAME_OUTPUT_DIRECTORY)
        get_filename_component(_output "${GAME_OUTPUT_DIRECTORY}" ABSOLUTE)
    else()
        set(_output "${CMAKE_CURRENT_BINARY_DIR}")
    endif()
    file(GLOB _generated CONFIGURE_DEPENDS "${_root}/src/generated/*.cpp")
    set(_registration "#pragma once\n#include \"project/GameTypes.hpp\"\n")
    set(_calls "")
    foreach(_cpp IN LISTS _generated)
        get_filename_component(_name "${_cpp}" NAME_WE)
        if(NOT _name MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
            message(FATAL_ERROR "Invalid generated behaviour filename: ${_cpp}")
        endif()
        string(APPEND _registration "#include \"${_root}/src/generated/${_name}.hpp\"\n")
        string(APPEND _calls "    saida::registerGameBehaviour<game::${_name}>();\n")
    endforeach()
    string(APPEND _registration "namespace saida { inline void registerProjectTypes() {\n${_calls}} }\n")
    set(_header "${CMAKE_CURRENT_BINARY_DIR}/${target}-generated/ProjectTypes.hpp")
    file(GENERATE OUTPUT "${_header}" CONTENT "${_registration}")
    add_executable(${target} ${GAME_SOURCES} ${_generated})
    if(NOT GAME_CUSTOM_MAIN)
        target_sources(${target} PRIVATE "${SaidaEngine_SOURCE_DIR}/src/runtime/main.cpp")
        target_compile_definitions(${target} PRIVATE
            SAIDA_DEFAULT_PROJECT="${_root}"
            SAIDA_GAME_TYPES_HEADER="${_header}")
        add_custom_target(${target}_package
            COMMAND "${SaidaEngine_BUILD_DIR}/bin/saida_tool${CMAKE_EXECUTABLE_SUFFIX}"
                export-game "${_root}" --runtime "$<TARGET_FILE:${target}>"
                --out "${CMAKE_CURRENT_BINARY_DIR}/package"
            DEPENDS ${target} VERBATIM)
    endif()
    target_link_libraries(${target} PRIVATE Saida::Engine)
    target_include_directories(${target} PRIVATE "${_root}/src"
        "${CMAKE_CURRENT_BINARY_DIR}/${target}-generated")
    set(_executables ${target})
    if(GAME_WITH_EDITOR)
        add_executable(${target}_editor EXCLUDE_FROM_ALL
            "${SaidaEngine_SOURCE_DIR}/src/main.cpp" ${_generated})
        target_link_libraries(${target}_editor PRIVATE Saida::Editor)
        target_compile_definitions(${target}_editor PRIVATE
            SAIDA_DEFAULT_PROJECT="${_root}" SAIDA_GAME_TYPES_HEADER="${_header}"
            SAIDA_GAME_PLAYER="$<TARGET_FILE:${target}>")
        add_dependencies(${target}_editor ${target})
        list(APPEND _executables ${target}_editor)
    endif()
    foreach(_exe IN LISTS _executables)
        set_target_properties(${_exe} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${_output}")
    endforeach()
    if(WIN32)
        get_target_property(_glfw_dll glfw IMPORTED_LOCATION)
        if(NOT _glfw_dll)
            get_target_property(_configs glfw IMPORTED_CONFIGURATIONS)
            foreach(_config IN LISTS _configs)
                get_target_property(_glfw_dll glfw IMPORTED_LOCATION_${_config})
                if(_glfw_dll)
                    break()
                endif()
            endforeach()
        endif()
        if(NOT _glfw_dll)
            message(FATAL_ERROR "Cannot locate the GLFW runtime DLL")
        endif()
        # Configure-time staging avoids a nested cmd.exe post-link command,
        # which misquotes Windows build directories containing '&'.
        configure_file("${_glfw_dll}" "${_output}/glfw3.dll" COPYONLY)
    endif()
endfunction()
