# Shared by desktop, Web and mobile exports. No installed downloader, codec or
# certificate file is required by the resulting player.
set(SAIDA_MEDIA_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    # The iOS backend manages AVAudioSession through Objective-C. This changes
    # only the owned implementation unit, keeping upstream miniaudio intact.
    enable_language(OBJCXX)
    set_source_files_properties("${SAIDA_MEDIA_ROOT}/src/audio/AudioUsage.cpp" PROPERTIES LANGUAGE OBJCXX)
endif()
function(saida_add_media_runtime target)
    target_sources(${target} PRIVATE "${SAIDA_MEDIA_ROOT}/src/net/HttpUrl.cpp")
    target_include_directories(${target} PUBLIC "${SAIDA_MEDIA_ROOT}/src")
    if(EMSCRIPTEN)
        target_sources(${target} PRIVATE
            "${SAIDA_MEDIA_ROOT}/src/net/HttpRequestWeb.cpp"
            "${SAIDA_MEDIA_ROOT}/src/audio/AudioStreamWeb.cpp")
        return()
    endif()
    if(NOT TARGET libcurl_static)
        # Build the unmodified LTS source with the policy baseline required by
        # current CMake, rather than patching its older minimum declaration.
        set(CMAKE_POLICY_VERSION_MINIMUM 3.10)
        set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
        set(ENABLE_PROGRAMS OFF CACHE BOOL "" FORCE)
        set(MBEDTLS_FATAL_WARNINGS OFF CACHE BOOL "" FORCE)
        set(USE_SHARED_MBEDTLS_LIBRARY OFF CACHE BOOL "" FORCE)
        set(USE_STATIC_MBEDTLS_LIBRARY ON CACHE BOOL "" FORCE)
        add_subdirectory("${SAIDA_MEDIA_ROOT}/third_party/mbedtls" "${CMAKE_BINARY_DIR}/media-mbedtls" EXCLUDE_FROM_ALL)
        set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
        set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
        set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
        set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
        set(BUILD_MISC_DOCS OFF CACHE BOOL "" FORCE)
        set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
        set(BUILD_TESTING OFF)
        set(CURL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
        foreach(protocol DICT FILE FTP GOPHER IMAP IPFS LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP)
            set(CURL_DISABLE_${protocol} ON CACHE BOOL "" FORCE)
        endforeach()
        set(CURL_USE_MBEDTLS ON CACHE BOOL "" FORCE)
        foreach(option CURL_USE_OPENSSL CURL_USE_SCHANNEL CURL_USE_LIBPSL CURL_ZLIB CURL_BROTLI CURL_ZSTD USE_NGHTTP2 USE_LIBIDN2 CURL_USE_LIBSSH2 CURL_USE_LIBSSH CURL_USE_GSSAPI CURL_USE_LIBUV CURL_USE_LDAP CURL_USE_PKGCONFIG)
            set(${option} OFF CACHE BOOL "" FORCE)
        endforeach()
        # Supply in-tree targets directly, so cross builds never discover host libraries.
        set(MBEDTLS_INCLUDE_DIR "${SAIDA_MEDIA_ROOT}/third_party/mbedtls/include")
        set(MBEDTLS_LIBRARY mbedtls)
        set(MBEDX509_LIBRARY mbedx509)
        set(MBEDCRYPTO_LIBRARY mbedcrypto)
        add_subdirectory("${SAIDA_MEDIA_ROOT}/third_party/curl" "${CMAKE_BINARY_DIR}/media-curl" EXCLUDE_FROM_ALL)
    endif()
    file(READ "${SAIDA_MEDIA_ROOT}/third_party/cacert/cacert.pem" SAIDA_HTTP_CA_PEM)
    configure_file("${SAIDA_MEDIA_ROOT}/cmake/HttpCertificates.hpp.in" "${CMAKE_BINARY_DIR}/media-generated/saida/HttpCertificates.hpp" @ONLY)
    target_include_directories(${target} PRIVATE "${CMAKE_BINARY_DIR}/media-generated" "${SAIDA_MEDIA_ROOT}/third_party/miniaudio")
    target_sources(${target} PRIVATE
        "${SAIDA_MEDIA_ROOT}/src/net/HttpTransport.cpp"
        "${SAIDA_MEDIA_ROOT}/src/net/HttpRequestNative.cpp"
        "${SAIDA_MEDIA_ROOT}/src/audio/AudioStream.cpp")
    find_package(Threads REQUIRED)
    target_link_libraries(${target} PUBLIC libcurl_static Threads::Threads ${CMAKE_DL_LIBS})
    if(ANDROID)
        target_link_libraries(${target} PUBLIC log android OpenSLES)
    elseif(APPLE)
        target_compile_definitions(${target} PRIVATE MA_NO_RUNTIME_LINKING)
        target_link_libraries(${target} PUBLIC "-framework CoreAudio" "-framework AudioToolbox" "-framework CoreFoundation")
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            target_link_libraries(${target} PUBLIC "-framework AVFoundation" "-framework Foundation")
        endif()
    endif()
endfunction()
